<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!--
      Four bars pinned at the joints. Each lies over the ones before it, and the overlap is a
      real gap in the alpha rather than a dark line painted on: the themed layer keeps only the
      alpha, so a painted seam would separate the bars at full colour and flatten back to one
      blob when tinted. Cutting means both layers show the same mechanism.

      A clip-path cannot add, only keep, so each bar sits in its own group clipped by the
      capsules of the bars above it. Those capsules are the bar outline grown by 0.65 either
      side - the 1.3 seam. The width is the whole design: at 3.5 the cuts stop separating the
      bars and start severing them, taking the middle rhombus with them.

      Every subtraction runs counter to the square around it, because a clip-path reads only
      name and pathData - fillType is dropped and the default nonZero rule decides. Wound the
      same way round they would add up to 2 and nothing would be cut.
    -->

    <group>
        <clip-path android:pathData="M0,0h108v108h-108z
                M29,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M41.5,54m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M54,41.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M66.5,54m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M79,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M54,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0" />

        <group>
            <!-- bar1 passes under bar2, bar3, bar4 -->
            <clip-path android:pathData="M0,0h108v108h-108z
                M50.54,44.96L75.54,69.96A4.9,4.9 0 0,0 82.46,63.04L57.46,38.04A4.9,4.9 0 0,0 50.54,44.96Z
                M38.04,57.46L50.54,69.96A4.9,4.9 0 0,0 57.46,63.04L44.96,50.54A4.9,4.9 0 0,0 38.04,57.46Z
                M57.46,69.96L69.96,57.46A4.9,4.9 0 0,0 63.04,50.54L50.54,63.04A4.9,4.9 0 0,0 57.46,69.96Z" />
            <path android:pathData="M29,66.5 L54,41.5"
                android:strokeWidth="8.5" android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="37"
                    android:endX="54" android:endY="71">
                    <item android:offset="0" android:color="#EE8F3C" />
                    <item android:offset="1" android:color="#BE5A26" />
                </gradient>
            </aapt:attr>
            </path>
        </group>
        <group>
            <!-- bar2 passes under bar3, bar4 -->
            <clip-path android:pathData="M0,0h108v108h-108z
                M38.04,57.46L50.54,69.96A4.9,4.9 0 0,0 57.46,63.04L44.96,50.54A4.9,4.9 0 0,0 38.04,57.46Z
                M57.46,69.96L69.96,57.46A4.9,4.9 0 0,0 63.04,50.54L50.54,63.04A4.9,4.9 0 0,0 57.46,69.96Z" />
