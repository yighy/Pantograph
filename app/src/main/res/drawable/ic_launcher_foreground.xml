<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The pantograph linkage the app is named after: a hinged rhombus between two arms,
      where holding one point makes another point draw.

      Two polylines rather than six bars, because the linkage is geometrically two straight
      arms crossing a rhombus - the outer chevron runs straight through the mid pivots, so
      splitting it into segments would only invite them to drift out of line.

      Fitted to the adaptive safe zone: the outermost pivots sit 29.1 from centre (54,54) and
      the bars add 3.5 either side, landing at 32.6 against the 33 a circular mask guarantees.
      Bars are deliberately heavier than scale from the reference drawing would give - at
      launcher size the true proportion came out around a pixel wide.
    -->

    <!-- Outer arms: left end through the mid pivot to the apex, and down the other side -->
    <path
        android:pathData="M28,67 L54,41 L80,67"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="34"
                android:endX="54"
                android:endY="74">
                <item android:offset="0" android:color="#EE8F3C" />
                <item android:offset="1" android:color="#BE5A26" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The two short bars that close the rhombus onto the bottom pivot -->
    <path
        android:pathData="M41,54 L54,67 L67,54"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="47"
                android:endX="54"
                android:endY="74">
                <item android:offset="0" android:color="#E3833A" />
                <item android:offset="1" android:color="#BE5A26" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      The six joints. Cream discs rather than the holes of the reference drawing: a hole of
      the same proportion closes up at icon size, and the light dot keeps the palette the
      rest of the app already uses. The monochrome layer does punch them through, because
      there the system keeps only the alpha and a second colour is not available.
    -->
    <path android:fillColor="#F7F2E9" android:pathData="M28,67m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
    <path android:fillColor="#F7F2E9" android:pathData="M41,54m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
    <path android:fillColor="#F7F2E9" android:pathData="M54,41m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
    <path android:fillColor="#F7F2E9" android:pathData="M67,54m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
    <path android:fillColor="#F7F2E9" android:pathData="M80,67m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
    <path android:fillColor="#F7F2E9" android:pathData="M54,67m-2.8,0a2.8,2.8 0 1,1 5.6,0a2.8,2.8 0 1,1 -5.6,0" />
</vector>
