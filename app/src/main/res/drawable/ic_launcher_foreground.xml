<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The pantograph linkage the app is named after: a hinged rhombus between two arms, where
      holding one point makes another point draw.

      Two polylines rather than six bars, because the linkage is geometrically two straight
      arms crossing a rhombus - the outer chevron runs straight through the mid pivots, so
      splitting it into segments would only invite them to drift out of line.

      The joints are cut out of the alpha rather than painted over in the background colour.
      A launcher may parallax the foreground against the background, and painted-on dots would
      slide off the ground they are imitating; a hole always shows whatever is actually behind.
      VectorDrawable has no blend modes, so an evenOdd clip is the only subtraction available.

      Bar weight and hole size are a pair: at 8.5 wide with holes of 2.6 there is 1.65 of bar
      left either side of each joint. Thinner bars, or wider holes, and the joints sever the
      arms at small sizes; narrower holes and they read as pinpricks at large ones.

      Fitted to the adaptive safe zone: the outermost pivots sit 27.95 from centre (54,54) and
      the bars add 4.25, landing at 32.2 against the 33 a circular mask guarantees.
    -->

    <group>
        <!--
          The joints are subtracted by winding direction, not by fillType: a <clip-path> reads
          only name and pathData, so an evenOdd declared here is dropped and the default
          nonZero rule applies. The circles therefore run counter to the square around them -
          winding 1 minus 1 is zero, which is the hole. Drawn the same way round as the square
          they came to 2 and stayed solid, which is exactly what shipped before this.
     -->
        <clip-path
            android:pathData="M0,0h108v108h-108z
                M29,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M41.5,54m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M54,41.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M66.5,54m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M79,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0
                M54,66.5m-2.6,0a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0" />

        <!-- Outer arms: left end through the mid pivot to the apex, and down the other side -->
        <path
            android:pathData="M29,66.5 L54,41.5 L79,66.5"
            android:strokeWidth="8.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="37"
                    android:endX="54" android:endY="71">
                    <item android:offset="0" android:color="#EE8F3C" />
                    <item android:offset="1" android:color="#BE5A26" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- The two short bars that close the rhombus onto the bottom pivot -->
        <path
            android:pathData="M41.5,54 L54,66.5 L66.5,54"
            android:strokeWidth="8.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="49"
                    android:endX="54" android:endY="71">
                    <item android:offset="0" android:color="#E3833A" />
                    <item android:offset="1" android:color="#BE5A26" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
